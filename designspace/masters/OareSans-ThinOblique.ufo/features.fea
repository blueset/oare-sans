feature aalt {
# Access All Alternates

#> feature
  feature salt;
  feature locl;
  feature case;
  feature ss01;
  feature ss02;
  feature ss03;
  feature ss04;
  feature pnum;
  feature tnum;
#< feature
} aalt;
feature salt {
# Stylistic Alternates

#> feature
  sub IJ from [IJ.ss01];
  sub J from [J.ss01];
  sub Jcircumflex from [Jcircumflex.ss01];
  sub S from [S.ss03 S.ss04];
  sub Sacute from [Sacute.ss03 Sacute.ss04];
  sub Scaron from [Scaron.ss03 Scaron.ss04];
  sub Scedilla from [Scedilla.ss03 Scedilla.ss04];
  sub Scircumflex from [Scircumflex.ss03 Scircumflex.ss04];
  sub Scommaaccent from [Scommaaccent.ss03 Scommaaccent.ss04];
  sub a from [a.ss02];
  sub aacute from [aacute.ss02];
  sub abreve from [abreve.ss02];
  sub acaron from [acaron.ss02];
  sub acircumflex from [acircumflex.ss02];
  sub adieresis from [adieresis.ss02];
  sub adieresismacron from [adieresismacron.ss02];
  sub adotaccent from [adotaccent.ss02];
  sub adotmacron from [adotmacron.ss02];
  sub agrave from [agrave.ss02];
  sub amacron from [amacron.ss02];
  sub aogonek from [aogonek.ss02];
  sub aring from [aring.ss02];
  sub aringacute from [aringacute.ss02];
  sub atilde from [atilde.ss02];
  sub caroncomb from [caroncomb.alt];
  sub dollar from [dollar.ss03 dollar.ss04];
  sub dollar.tf from [dollar.ss03.tf dollar.ss04.tf];
  sub dollar.through from [dollar.through.ss03 dollar.through.ss04];
  sub dollar.through.tf from [dollar.through.ss03.tf dollar.through.ss04.tf];
  sub five from [five.ss03];
  sub five.tf from [five.ss03.tf];
  sub ordfeminine from [ordfeminine.ss02];
  sub s from [s.ss03];
  sub sacute from [sacute.ss03];
  sub scaron from [scaron.ss03];
  sub scedilla from [scedilla.ss03];
  sub scircumflex from [scircumflex.ss03];
  sub scommaaccent from [scommaaccent.ss03];
#< feature
} salt;

feature locl {
# Localized Forms
  # script latn; # Latin

#> feature
  script latn; # Latin
  language MOL; # Moldavian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;

  language ROM; # Romanian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;

  language TRK; # Turkish
  sub i by i.loclTRK;
#< feature

	# locl before liga for `i by i.loclTRK` override to prevent dotless ligatures

	language NLD;
	sub iacute j' by jacute;
	sub Iacute J' by Jacute;

	language CAT; # Catalan
	sub l periodcentered' l by periodcentered.CAT;
	sub L periodcentered' L by periodcentered.CAT.case;
} locl;

feature liga {
# Standard Ligatures

#> feature
  sub f f by f_f;
  sub f i by f_i;
  sub f j by f_j;
  sub f l by f_l;
  sub f t by f_t;
  sub g j by g_j.liga;
  sub q j by q_j.liga;
  sub f f i by f_f_i;
  sub f f j by f_f_j;
  sub f f l by f_f_l;
  sub f f t by f_f_t;
#< feature
} liga;

feature ordn {
# Ordinals

#> feature
  sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
  sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;
#< feature
} ordn;

feature ccmp {
# Glyph Composition/Decomposition

#> feature
#< feature

	sub iogonek' @TopMarkComb by iogonek.dotless;
	sub i'       @TopMarkComb by dotlessi;
	sub j'       @TopMarkComb by dotlessj;

	# QJ descender collision
	sub Q J' by J.ss01;
} ccmp;

feature case {
# Case Sensitive Forms

#> feature
  sub asterisk by asterisk.case;
  sub at by at.case;
  sub colon by colon.case;
  sub emdash by emdash.case;
  sub endash by endash.case;
  sub exclamdown by exclamdown.case;
  sub guillemotleft by guillemotleft.case;
  sub guillemotright by guillemotright.case;
  sub guilsinglleft by guilsinglleft.case;
  sub guilsinglright by guilsinglright.case;
  sub hyphen by hyphen.case;
  sub periodcentered.CAT by periodcentered.CAT.case;
  sub questiondown by questiondown.case;
#< feature
} case;

feature ss01 {
# Stylistic Set 01–20

	featureNames {
		name "Alternative J";
	};

#> feature
  sub IJ by IJ.ss01;
  sub J by J.ss01;
  sub Jcircumflex by Jcircumflex.ss01;
#< feature
} ss01;

