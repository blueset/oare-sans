#/> classes
#/> tags
@BottomMark = [cedilla ogonek];
@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];
@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash thorn];
@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];
@MarkSpacing = [acute breve caron cedilla circumflex dieresis dotaccent grave hungarumlaut macron ogonek ring tilde];
@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron ring tilde];
@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];
#/< tags
#/< classes

