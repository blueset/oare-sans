feature locl {
# Localized Forms
  # script latn; # Latin

#> feature
  script latn; # Latin
  language MOL; # Moldavian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;

  language ROM; # Romanian
  sub Scedilla by Scommaaccent;
  sub Tcedilla by Tcommaaccent;
  sub scedilla by scommaaccent;
  sub tcedilla by tcommaaccent;

  language TRK; # Turkish
  sub i by i.loclTRK;
#< feature

	# locl before liga for `i by i.loclTRK` override to prevent dotless ligatures

	language NLD;
	sub iacute j' by jacute;
	sub Iacute J' by Jacute;

	language CAT; # Catalan
	sub l periodcentered' l by periodcentered.CAT;
	sub L periodcentered' L by periodcentered.CAT.case;
} locl;
feature liga {
# Standard Ligatures

#> feature
  sub f f by f_f;
  sub f i by f_i;
  sub f j by f_j;
  sub f l by f_l;
  sub f t by f_t;
  sub g j by g_j.liga;
  sub q j by q_j.liga;
  sub f f i by f_f_i;
  sub f f j by f_f_j;
  sub f f l by f_f_l;
  sub f f t by f_f_t;
#< feature
} liga;
feature ordn {
# Ordinals

#> feature
  sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
  sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;
#< feature
} ordn;
feature ccmp {
# Glyph Composition/Decomposition

#> feature
#< feature

	sub iogonek' @TopMarkComb by iogonek.dotless;
	sub i'       @TopMarkComb by dotlessi;
	sub j'       @TopMarkComb by dotlessj;

	# QJ descender collision
	sub Q J' by J.ss01;
} ccmp;
feature case {
# Case Sensitive Forms

#> feature
  sub periodcentered.CAT by periodcentered.CAT.case;
#< feature
} case;
