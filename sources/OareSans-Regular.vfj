        "feature":"#> classes\n#/> tags\n@BottomMark = [cedilla ogonek];\n@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];\n@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Oslashacute Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash oslashacute thorn];\n@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];\n@MarkSpacing = [acute breve caron cedilla circumflex commaturnedmod dieresis dotaccent grave hungarumlaut macron macronmod ogonek ring tilde];\n@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron macronmod ring tilde];\n@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];\n#/< tags\n#< classes\n\n#/> classes\n#/> tags\n@BottomMark = [cedilla ogonek];\n@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];\n@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Oslashacute Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash oslashacute thorn];\n@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];\n@MarkSpacing = [acute breve caron cedilla circumflex commaturnedmod dieresis dotaccent grave hungarumlaut macron macronmod ogonek ring tilde];\n@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron macronmod ring tilde];\n@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];\n#/< tags\n#/< classes\n\n#/> classes\n#/> tags\n@BottomMark = [cedilla ogonek];\n@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];\n@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Oslashacute Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash oslashacute thorn];\n@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];\n@MarkSpacing = [acute breve caron cedilla circumflex commaturnedmod dieresis dotaccent grave hungarumlaut macron macronmod ogonek ring tilde];\n@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron macronmod ring tilde];\n@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];\n#/< tags\n#/< classes\n\n#/> classes\n#/> tags\n@BottomMark = [cedilla ogonek];\n@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];\n@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Oslashacute Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash oslashacute thorn];\n@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];\n@MarkSpacing = [acute breve caron cedilla circumflex commaturnedmod dieresis dotaccent grave hungarumlaut macron macronmod ogonek ring tilde];\n@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron macronmod ring tilde];\n@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];\n#/< tags\n#/< classes\n\n#/> classes\n#/> tags\n@BottomMark = [cedilla ogonek];\n@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];\n@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Oslashacute Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash oslashacute thorn];\n@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];\n@MarkSpacing = [acute breve caron cedilla circumflex commaturnedmod dieresis dotaccent grave hungarumlaut macron macronmod ogonek ring tilde];\n@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron macronmod ring tilde];\n@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];\n#/< tags\n#/< classes\n\n#/> classes\n#/> tags\n@BottomMark = [cedilla ogonek];\n@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];\n@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Oslashacute Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash oslashacute thorn];\n@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];\n@MarkSpacing = [acute breve caron cedilla circumflex commaturnedmod dieresis dotaccent grave hungarumlaut macron macronmod ogonek ring tilde];\n@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron macronmod ring tilde];\n@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];\n#/< tags\n#/< classes\n\n#/> classes\n#/> tags\n@BottomMark = [cedilla ogonek];\n@BottomMarkComb = [cedillacomb commaaccent ogonekcomb];\n@ExtraLetters = [AE Dcroat Eth Germandbls Hbar Lslash OE Oslash Thorn ae dcroat eth gcommaaccent germandbls hbar lslash oe oslash thorn];\n@Mark = [acutecomb brevecomb caroncomb caroncomb.alt cedillacomb circumflexcomb commaaccent dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ogonekcomb ringcomb tildecomb];\n@MarkSpacing = [acute breve caron cedilla circumflex dieresis dotaccent grave hungarumlaut macron ogonek ring tilde];\n@TopMark = [acute breve caron circumflex dieresis dotaccent grave hungarumlaut macron ring tilde];\n@TopMarkComb = [acutecomb brevecomb caroncomb caroncomb.alt circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];\n#/< tags\n#/< classes\n\n###\n# OpenType Layout feature definitions\n# Format: Adobe FDK for OpenType (AFDKO) version 2.5\n# Generated on: 2026-3-5 14:54\n# Generated by: FontLab 8.0.0\n#\n# Totals:\n# Languagesystems: 0\n# GSUB lookups: 0\n# GPOS lookups: 0\n\n#\n# Languagesystem definitions\n#\n\n#> languagesystem\nlanguagesystem DFLT dflt;\nlanguagesystem latn dflt;\nlanguagesystem latn CAT;\nlanguagesystem latn MOL;\nlanguagesystem latn NLD;\nlanguagesystem latn ROM;\nlanguagesystem latn TRK;\n#< languagesystem\n\n#\n# Lookup definitions\n#\n\n"
      },
      {
        "name":"aalt",
        "feature":"feature aalt {\n# Access All Alternates\n\n#> feature\n  feature salt;\n  feature locl;\n  feature case;\n  feature ss01;\n  feature ss02;\n  feature ss03;\n  feature ss04;\n  feature pnum;\n  feature tnum;\n#< feature\n} aalt;\n"
      },
      {
        "name":"salt",
        "feature":"feature salt {\n# Stylistic Alternates\n\n#> feature\n  sub IJ from [IJ.ss01];\n  sub J from [J.ss01];\n  sub Jcircumflex from [Jcircumflex.ss01];\n  sub S from [S.ss03 S.ss04];\n  sub Sacute from [Sacute.ss03 Sacute.ss04];\n  sub Scaron from [Scaron.ss03 Scaron.ss04];\n  sub Scedilla from [Scedilla.ss03 Scedilla.ss04];\n  sub Scircumflex from [Scircumflex.ss03 Scircumflex.ss04];\n  sub Scommaaccent from [Scommaaccent.ss03 Scommaaccent.ss04];\n  sub a from [a.ss02];\n  sub aacute from [aacute.ss02];\n  sub abreve from [abreve.ss02];\n  sub acaron from [acaron.ss02];\n  sub acircumflex from [acircumflex.ss02];\n  sub adieresis from [adieresis.ss02];\n  sub adieresismacron from [adieresismacron.ss02];\n  sub adotaccent from [adotaccent.ss02];\n  sub adotmacron from [adotmacron.ss02];\n  sub agrave from [agrave.ss02];\n  sub amacron from [amacron.ss02];\n  sub aogonek from [aogonek.ss02];\n  sub aring from [aring.ss02];\n  sub aringacute from [aringacute.ss02];\n  sub atilde from [atilde.ss02];\n  sub caroncomb from [caroncomb.alt];\n  sub dollar from [dollar.ss03 dollar.ss04];\n  sub dollar.tf from [dollar.ss03.tf dollar.ss04.tf];\n  sub dollar.through from [dollar.through.ss03 dollar.through.ss04];\n  sub dollar.through.tf from [dollar.through.ss03.tf dollar.through.ss04.tf];\n  sub five from [five.ss03];\n  sub five.tf from [five.ss03.tf];\n  sub ordfeminine from [ordfeminine.ss02];\n  sub s from [s.ss03];\n  sub sacute from [sacute.ss03];\n  sub scaron from [scaron.ss03];\n  sub scedilla from [scedilla.ss03];\n  sub scircumflex from [scircumflex.ss03];\n  sub scommaaccent from [scommaaccent.ss03];\n#< feature\n} salt;\n\n"
      },
      {
        "name":"locl",
        "feature":"feature locl {\n# Localized Forms\n  # script latn; # Latin\n\n#> feature\n  script latn; # Latin\n  language MOL; # Moldavian\n  sub Scedilla by Scommaaccent;\n  sub Tcedilla by Tcommaaccent;\n  sub scedilla by scommaaccent;\n  sub tcedilla by tcommaaccent;\n\n  language ROM; # Romanian\n  sub Scedilla by Scommaaccent;\n  sub Tcedilla by Tcommaaccent;\n  sub scedilla by scommaaccent;\n  sub tcedilla by tcommaaccent;\n\n  language TRK; # Turkish\n  sub i by i.loclTRK;\n#< feature\n\n\t# locl before liga for `i by i.loclTRK` override to prevent dotless ligatures\n\n\tlanguage NLD;\n\tsub iacute j' by jacute;\n\tsub Iacute J' by Jacute;\n\n\tlanguage CAT; # Catalan\n\tsub l periodcentered' l by periodcentered.CAT;\n\tsub L periodcentered' L by periodcentered.CAT.case;\n} locl;\n\n"
      },
      {
        "name":"liga",
        "feature":"feature liga {\n# Standard Ligatures\n\n#> feature\n  sub f f by f_f;\n  sub f i by f_i;\n  sub f j by f_j;\n  sub f l by f_l;\n  sub f t by f_t;\n  sub g j by g_j.liga;\n  sub q j by q_j.liga;\n  sub f f i by f_f_i;\n  sub f f j by f_f_j;\n  sub f f l by f_f_l;\n  sub f f t by f_f_t;\n#< feature\n} liga;\n\n"
      },
      {
        "name":"ordn",
        "feature":"feature ordn {\n# Ordinals\n\n#> feature\n  sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;\n  sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;\n#< feature\n} ordn;\n\n"
      },
      {
        "name":"ccmp",
        "feature":"feature ccmp {\n# Glyph Composition/Decomposition\n\n#> feature\n#< feature\n\n\tsub iogonek' @TopMarkComb by iogonek.dotless;\n\tsub i'       @TopMarkComb by dotlessi;\n\tsub j'       @TopMarkComb by dotlessj;\n\n\t# QJ descender collision\n\tsub Q J' by J.ss01;\n} ccmp;\n\n"
      },
      {
        "name":"case",
        "feature":"feature case {\n# Case Sensitive Forms\n\n#> feature\n  sub asterisk by asterisk.case;\n  sub at by at.case;\n  sub colon by colon.case;\n  sub emdash by emdash.case;\n  sub endash by endash.case;\n  sub exclamdown by exclamdown.case;\n  sub guillemotleft by guillemotleft.case;\n  sub guillemotright by guillemotright.case;\n  sub guilsinglleft by guilsinglleft.case;\n  sub guilsinglright by guilsinglright.case;\n  sub hyphen by hyphen.case;\n  sub periodcentered.CAT by periodcentered.CAT.case;\n  sub questiondown by questiondown.case;\n#< feature\n} case;\n\n"
      },
      {
        "name":"ss01",
        "feature":"feature ss01 {\n# Stylistic Set 01–20\n\n\tfeatureNames {\n\t\tname \"Alternative J\";\n\t};\n\n#> feature\n  sub IJ by IJ.ss01;\n  sub J by J.ss01;\n  sub Jcircumflex by Jcircumflex.ss01;\n#< feature\n} ss01;\n\n"
      },
      {
        "name":"ss02",
        "feature":"feature ss02 {\n# Stylistic Set 01–20\n\tfeatureNames {\n\t\tname \"Single Story a\";\n\t};\n\n#> feature\n  sub a by a.ss02;\n  sub aacute by aacute.ss02;\n  sub abreve by abreve.ss02;\n  sub acaron by acaron.ss02;\n  sub acircumflex by acircumflex.ss02;\n  sub adieresis by adieresis.ss02;\n  sub adieresismacron by adieresismacron.ss02;\n  sub adotaccent by adotaccent.ss02;\n  sub adotmacron by adotmacron.ss02;\n  sub agrave by agrave.ss02;\n  sub amacron by amacron.ss02;\n  sub aogonek by aogonek.ss02;\n  sub aring by aring.ss02;\n  sub aringacute by aringacute.ss02;\n  sub atilde by atilde.ss02;\n  sub ordfeminine by ordfeminine.ss02;\n#< feature\n} ss02;\n\n"
      },
      {
        "name":"ss03",
        "feature":"feature ss03 {\n# Stylistic Set 01–20\n\tfeatureNames {\n\t\tname \"Alternative S and 5 (Symmetrical S)\";\n\t};\n\n#> feature\n  sub S by S.ss03;\n  sub Sacute by Sacute.ss03;\n  sub Scaron by Scaron.ss03;\n  sub Scedilla by Scedilla.ss03;\n  sub Scircumflex by Scircumflex.ss03;\n  sub Scommaaccent by Scommaaccent.ss03;\n  sub dollar by dollar.ss03;\n  sub dollar.through by dollar.through.ss03;\n  sub five by five.ss03;\n  sub s by s.ss03;\n  sub sacute by sacute.ss03;\n  sub scaron by scaron.ss03;\n  sub scedilla by scedilla.ss03;\n  sub scircumflex by scircumflex.ss03;\n  sub scommaaccent by scommaaccent.ss03;\n#< feature\n} ss03;\n\n"
      },
      {
        "name":"ss04",
        "feature":"feature ss04 {\n# Stylistic Set 01–20\n\tfeatureNames {\n\t\tname \"Alternative S and 5 (Asymmetrical S)\";\n\t};\n\n#> feature\n  sub S by S.ss04;\n  sub Sacute by Sacute.ss04;\n  sub Scaron by Scaron.ss04;\n  sub Scedilla by Scedilla.ss04;\n  sub Scircumflex by Scircumflex.ss04;\n  sub Scommaaccent by Scommaaccent.ss04;\n  sub dollar by dollar.ss04;\n  sub dollar.through by dollar.through.ss04;\n#< feature\n  sub s by s.ss03;\n  sub sacute by sacute.ss03;\n  sub scaron by scaron.ss03;\n  sub scedilla by scedilla.ss03;\n  sub scircumflex by scircumflex.ss03;\n  sub scommaaccent by scommaaccent.ss03;\n  sub five by five.ss03;\n} ss04;\n\n"
      },
      {
        "name":"pnum",
        "feature":"feature pnum {\n# Proportional Figures\n\n#> feature\n  sub Euro.tf by Euro;\n  sub asciitilde.tf by asciitilde;\n  sub cent.tf by cent;\n  sub colon.tf by colon;\n  sub comma.tf by comma;\n  sub divide.tf by divide;\n  sub dollar.tf by dollar;\n  sub eight.tf by eight;\n  sub equal.tf by equal;\n  sub five.tf by five;\n  sub four.tf by four;\n  sub greater.tf by greater;\n  sub less.tf by less;\n  sub logicalnot.tf by logicalnot;\n  sub minus.tf by minus;\n  sub multiply.tf by multiply;\n  sub nine.tf by nine;\n  sub numbersign.tf by numbersign;\n  sub one.tf by one;\n  sub period.tf by period;\n  sub plus.tf by plus;\n  sub plusminus.tf by plusminus;\n  sub semicolon.tf by semicolon;\n  sub seven.tf by seven;\n  sub six.tf by six;\n  sub slash.tf by slash;\n  sub space.tf by space;\n  sub sterling.tf by sterling;\n  sub three.tf by three;\n  sub two.tf by two;\n  sub yen.tf by yen;\n  sub zero.tf by zero;\n#< feature\n} pnum;\n\n"
      },
      {
        "name":"tnum",
        "feature":"feature tnum {\n# Tabular Figures\n\n#> feature\n  sub Euro by Euro.tf;\n  sub asciitilde by asciitilde.tf;\n  sub asterisk by asterisk.tf;\n  sub cent by cent.tf;\n  sub divide by divide.tf;\n  sub dollar by dollar.tf;\n  sub eight by eight.tf;\n  sub equal by equal.tf;\n  sub five by five.tf;\n  sub four by four.tf;\n  sub greater by greater.tf;\n  sub less by less.tf;\n  sub logicalnot by logicalnot.tf;\n  sub minus by minus.tf;\n  sub multiply by multiply.tf;\n  sub nine by nine.tf;\n  sub numbersign by numbersign.tf;\n  sub one by one.tf;\n  sub plus by plus.tf;\n  sub plusminus by plusminus.tf;\n  sub seven by seven.tf;\n  sub six by six.tf;\n  sub slash by slash.tf;\n  sub space by space.tf;\n  sub sterling by sterling.tf;\n  sub three by three.tf;\n  sub two by two.tf;\n  sub yen by yen.tf;\n  sub zero by zero.tf;\n#< feature\n  sub five.ss03 by five.ss03.tf;\n  sub colon by colon.case;\n  sub dollar.through by dollar.through.tf;\n  sub dollar.ss03 by dollar.ss03.tf;\n  sub dollar.through.ss03 by dollar.through.ss03.tf;\n  sub dollar.ss04 by dollar.ss04.tf;\n  sub dollar.through.ss04 by dollar.through.ss04.tf;\n} tnum;\n\n"
      }
    ],
